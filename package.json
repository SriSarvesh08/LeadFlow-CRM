    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:leads": "cd services/leads-service && npm run dev",
    "dev:customers": "cd services/customers-service && npm run dev",
    "dev:sales": "cd services/sales-service && npm run dev",
    "dev:activity": "cd services/activity-service && npm run dev",
    "dev:support": "cd services/support-service && npm run dev",
