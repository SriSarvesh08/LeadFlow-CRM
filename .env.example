# ============================================================
# LeadFlow CRM — Root Environment Variables Template (.env.example)
# Do NOT commit actual .env files containing real passwords
# ============================================================

# System Environment
NODE_ENV=development

# API Gateway (Port 5000)
# Note: Express server.js reads process.env.PORT; GATEWAY_PORT is retained for backwards compatibility
PORT=5000
GATEWAY_PORT=5000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting (API Gateway)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Microservices Ports & Internal URLs
AUTH_SERVICE_URL=http://localhost:5001
LEADS_SERVICE_URL=http://localhost:5002
CUSTOMERS_SERVICE_URL=http://localhost:5003
SALES_SERVICE_URL=http://localhost:5004
ACTIVITY_SERVICE_URL=http://localhost:5005
SUPPORT_SERVICE_URL=http://localhost:5006
NOTIFICATION_SERVICE_URL=http://localhost:5007

# ------------------------------------------------------------
# Local Standalone MySQL Settings (Local Development)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME_AUTH=crm_auth
DB_NAME_CUSTOMERS=crm_customers
DB_NAME_SALES=crm_sales

# ------------------------------------------------------------
# Docker Compose MySQL Container & Per-Service Accounts
# ------------------------------------------------------------
# Root password for the MySQL container
MYSQL_ROOT_PASSWORD=your_mysql_root_password
# Application accounts for isolated service access
DB_USER_AUTH=crm_auth_app
DB_PASSWORD_AUTH=auth_password
DB_USER_CUSTOMERS=crm_customers_app
DB_PASSWORD_CUSTOMERS=customers_password
DB_USER_SALES=crm_sales_app
DB_PASSWORD_SALES=sales_password

# ------------------------------------------------------------
# Local Standalone MongoDB Settings (Local Development)
# ------------------------------------------------------------
MONGO_URI_LEADS=mongodb://localhost:27017/crm_leads
MONGO_URI_ACTIVITY=mongodb://localhost:27017/crm_activity
MONGO_URI_SUPPORT=mongodb://localhost:27017/crm_support
MONGO_URI_NOTIFY=mongodb://localhost:27017/crm_notify

# ------------------------------------------------------------
# Docker Compose MongoDB Container & Per-Service Accounts
# ------------------------------------------------------------
# Root administrator for the MongoDB container
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_mongo_root_password
# Application accounts for isolated service access
MONGO_LEADS_USER=crm_leads_app
MONGO_LEADS_PASSWORD=leads_password
MONGO_ACTIVITY_USER=crm_activity_app
MONGO_ACTIVITY_PASSWORD=activity_password
MONGO_SUPPORT_USER=crm_support_app
MONGO_SUPPORT_PASSWORD=support_password
MONGO_NOTIFICATION_USER=crm_notify_app
MONGO_NOTIFICATION_PASSWORD=notification_password

# ------------------------------------------------------------
# JWT & Authentication Secrets
# ------------------------------------------------------------
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=replace_with_secure_reset_secret
RESET_TOKEN_EXPIRES_IN=1h

# ------------------------------------------------------------
# Inter-Service Security
# ------------------------------------------------------------
INTERNAL_SERVICE_KEY=replace_with_secure_internal_key

# ------------------------------------------------------------
# Email Configuration (Nodemailer)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@leadflow.in
