# ============================================================
# LeadFlow CRM — Root Environment Variables Template (.env.example)
# Do NOT commit actual .env files containing real passwords
# ============================================================

# System Environment
NODE_ENV=development

# API Gateway (Port 5000)
GATEWAY_PORT=5000
FRONTEND_URL=http://localhost:3000

# Microservices Ports & Internal URLs
AUTH_SERVICE_URL=http://localhost:5001
LEADS_SERVICE_URL=http://localhost:5002
CUSTOMERS_SERVICE_URL=http://localhost:5003
SALES_SERVICE_URL=http://localhost:5004
ACTIVITY_SERVICE_URL=http://localhost:5005
SUPPORT_SERVICE_URL=http://localhost:5006
NOTIFICATION_SERVICE_URL=http://localhost:5007

# MySQL Database Settings (Member 3 / Shared)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME_AUTH=crm_auth
DB_NAME_CUSTOMERS=crm_customers
DB_NAME_SALES=crm_sales

# MongoDB Database Settings (Member 3 / Shared)
MONGO_URI_LEADS=mongodb://localhost:27017/crm_leads
MONGO_URI_ACTIVITY=mongodb://localhost:27017/crm_activity
MONGO_URI_SUPPORT=mongodb://localhost:27017/crm_support
MONGO_URI_NOTIFY=mongodb://localhost:27017/crm_notify

# JWT & Authentication Secrets
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Inter-Service Security
INTERNAL_SERVICE_KEY=replace_with_secure_internal_key

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@leadflow.in
