# Leads Service — Environment Variables
PORT=5002
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/crm_leads

# JWT Secret (required for direct Bearer token verification fallback in auth middleware)
JWT_SECRET=your_jwt_secret_key_here

# Internal service key
INTERNAL_SERVICE_KEY=your_internal_key_here

# Service URLs (for inter-service calls)
CUSTOMERS_SERVICE_URL=http://localhost:5003
SALES_SERVICE_URL=http://localhost:5004
ACTIVITY_SERVICE_URL=http://localhost:5005
NOTIFICATION_SERVICE_URL=http://localhost:5007

# Browser CORS allowlist (comma-separated exact origins)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
